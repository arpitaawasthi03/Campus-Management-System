<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
    <session-factory>
        <!-- H2 In-Memory Database connection for testing -->
        <property name="hibernate.connection.driver_class">org.h2.Driver</property>
        <property name="hibernate.connection.url">jdbc:h2:mem:campustest;DB_CLOSE_DELAY=-1;MODE=MySQL</property>
        <property name="hibernate.connection.username">sa</property>
        <property name="hibernate.connection.password"></property>

        <!-- Echo SQL -->
        <property name="hibernate.show_sql">false</property>
        <property name="hibernate.format_sql">false</property>

        <!-- Schema auto recreation -->
        <property name="hibernate.hbm2ddl.auto">update</property>

        <!-- Entity Mappings -->
        <mapping class="com.campus.model.Student"/>
        <mapping class="com.campus.model.Course"/>
        <mapping class="com.campus.model.Department"/>
        <mapping class="com.campus.model.Faculty"/>
    </session-factory>
</hibernate-configuration>
